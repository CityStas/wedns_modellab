# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Бэкапы конфигов LM Studio, создаваемые weds tune --apply
*.weds-backup

# Локальные артефакты прогонов
chk.json
chk.err
*.local.json

# Логи движка: пишутся на каждый прогон, в репозиторий не идут
modellab/logs/
_smoke-server.log

# Профили подбора конфига. Привязаны к железу и содержат абсолютные пути
# к моделям этой машины: у клона они не совпадут ни с чем. Файл создаётся
# сам при первом подборе, отсутствие обрабатывается (search.load_profiles).
modellab/profiles.json

# Разовые выгрузки состояния и черновые снимки экрана
_gui*.out
bench.json
_shots/

# Заметки проекта: остаются локально, в публичный репозиторий не идут
.workbuddy-ai/

# Личная чистка машины: валит процессы WorkBuddy и MCP-серверы сессии.
# В публичном репозитории такому скрипту не место.
kill-all.cmd
